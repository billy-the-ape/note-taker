# Keeps the Docker build context small and keeps host state out of the image.
# PR-18 owns the multi-stage image: it installs and builds INSIDE the image, so the compiled
# apps/server/dist and apps/web/dist are produced there rather than copied from a developer machine.
# `dist/` is therefore ignored — a release must not be shippable from a build that happened to be lying
# around in someone's checkout, and `tsc` does not delete output whose source has gone away. The Dockerfile
# deletes the three dists again before building, so the guarantee survives anyone editing this file.
.git
.github
.clinerules
docs

node_modules
dist
*.tsbuildinfo
.pnpm-store

# A real .env must never reach an image; the template is documentation, not runtime input.
.env
.env.*

coverage
coverage-unit
coverage-integration
playwright-report
test-results

# Browser tests run on the host/CI, never inside the image (PR-19).
apps/web/e2e

.dev
*.log
.DS_Store
.idea
.vscode
