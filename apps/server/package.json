{
  "name": "@note-taker/server",
  "version": "0.1.0",
  "private": true,
  "description": "Note Taker API (Fastify 5).",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts",
    "coverage:integration": "NODE_ENV=test vitest run --config vitest.integration.config.ts --coverage",
    "db:generate": "NODE_ENV=development drizzle-kit generate",
    "db:migrate": "NODE_ENV=development drizzle-kit migrate",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@note-taker/contracts": "workspace:*",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "postgres": "4.1.1",
    "uuid": "14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.1",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
