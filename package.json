{
  "name": "note-taker",
  "version": "0.0.0",
  "private": true,
  "description": "Note Taker — a self-hosted markdown notes app (pnpm monorepo: apps/server + apps/web).",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "pnpm build:packages && pnpm -r --parallel --filter './apps/**' dev",
    "build": "pnpm build:packages && pnpm -r --filter './apps/**' build",
    "build:packages": "pnpm -r --filter './packages/**' build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm build && pnpm --filter @note-taker/web test:e2e",
    "coverage:integration": "pnpm -r coverage:integration",
    "db:generate": "pnpm -r db:generate",
    "db:migrate": "pnpm -r db:migrate",
    "db:seed": "pnpm -r db:seed",
    "generate:key": "pnpm --filter @note-taker/server exec tsx ../../scripts/generate-keys.ts",
    "check:env": "NODE_ENV=production tsx scripts/check-env.ts",
    "coverage": "pnpm -r coverage"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
