# scripts/fixtures/prod-missing-key.env — a fixture for `pnpm check:env`, NOT a runnable environment.
#
# It is the repo-root `.env` of docs/DEPLOY.md §2 **minus the `NOTE_ENCRYPTION_KEY` line**, which is the one
# thing a fresh `.env` cannot be without: the CI `build` job asserts `pnpm check:env` fails naming that
# variable (and that `docker compose config` fails naming the same one) before either is asked to start
# anything, then appends a key to a copy of this file and asserts both go quiet.
#
# Three properties make the exit-0 half of that assertion reachable, so they are asserted by their absence
# here rather than argued in prose:
#
#   * **no `NODE_ENV` entry** — the image bakes `NODE_ENV=production` and `docker/compose.yml` repeats it, so
#     a mode line in this file would be inert inside the stack and wrong in a sourced shell;
#   * **no `DATABASE_URL` line** — `docker/compose.yml` composes it from the trio with host `db`, and
#     `env.ts`'s `databaseUrl()` derives it on the host (a `DATABASE_URL` written in a file freezes, because
#     `process.loadEnvFile` expands nothing);
#   * **all three `POSTGRES_*` values present** — that trio *is* the second form of the DSN rule §5 of
#     docs/plans/mvp/MVP-18.md describes, and the runbook's shell reads each of them for `pg_dump`.

POSTGRES_USER=notetaker
POSTGRES_PASSWORD=pr18fixturepassword0123456789abcdef
POSTGRES_DB=notetaker

# The port `docker/compose.yml` publishes: `"${HOST_PORT:-3000}:3000"`.
HOST_PORT=3000

# The three flags a first deploy ships with, spelled out so the file says what it means: registration closed
# (`POST /api/auth/register` answers 403 while no owner exists — /setup is the door), no TLS terminator in
# front of it, therefore no `Secure` cookie.
SECURE_COOKIES=false
TRUST_PROXY=false
ALLOW_REGISTRATION=false

# The version tag every new note is sealed with. 1 because this is a first key, and `NOTE_ENCRYPTION_KEY`
# would sit on the line above — which is exactly what the CI job adds.
NOTE_ENCRYPTION_KEY_VERSION=1
