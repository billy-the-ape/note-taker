# scripts/fixtures/prod-no-dsn.env — a fixture for `pnpm check:env`, NOT a runnable environment.
#
# The negative case of the DSN carve-out (docs/plans/mvp/MVP-18.md §5): a file with **neither** form of a
# database — no `DATABASE_URL` line and no `POSTGRES_USER`/`POSTGRES_PASSWORD`/`POSTGRES_DB` trio — must
# exit non-zero naming *both* options, because that is the failure an operator otherwise meets as a
# container that restarts forever with a `DATABASE_URL is required in production` line in its log.
#
# The key below is present and valid so this file has exactly one problem and the assertion greps for one
# thing. It is a fixture, not a secret: the base64 below decodes to the ASCII
# `pr18-fixture-key-not-a-secretxx!`, 32 bytes of "do not use this anywhere".

NOTE_ENCRYPTION_KEY=cHIxOC1maXh0dXJlLWtleS1ub3QtYS1zZWNyZXR4eCE=
NOTE_ENCRYPTION_KEY_VERSION=1

HOST_PORT=3000
LOG_LEVEL=info
